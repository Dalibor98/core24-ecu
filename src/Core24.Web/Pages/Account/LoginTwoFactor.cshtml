@page "/account/login-2fa"
@model Core24.Web.Pages.Account.LoginTwoFactorModel
@{
    ViewData["Title"] = "Two-factor login";
}
<div class="head">
    <p class="eyebrow">Account</p>
    <h1>One more step</h1>
    <p class="lede">Open your authenticator app and type the 6-digit code for CORE24. Lost your phone? Type one of your recovery codes instead.</p>
</div>

<form method="post" class="card stack" asp-route-returnUrl="@Model.ReturnUrl" asp-route-rememberMe="@Model.RememberMe">
    <div asp-validation-summary="All"></div>
    <div class="field">
        <label asp-for="Input.Code"></label>
        <input asp-for="Input.Code" autocomplete="one-time-code" autofocus>
    </div>
    <div class="actions">
        <button class="btn primary" type="submit">Log in</button>
    </div>
</form>
