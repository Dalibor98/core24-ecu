@page "/account/reset-password"
@model Core24.Web.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Choose a new password";
}
<div class="head">
    <p class="eyebrow">Account</p>
    <h1>Choose a new password</h1>
</div>

@if (Model.Done)
{
    <div class="notice ok">Your password was changed. You can log in with the new one now.</div>
    <p><a class="btn primary" asp-page="/Account/Login">Log in</a></p>
}
else
{
    <form method="post" class="card stack">
        <div asp-validation-summary="All"></div>
        <input type="hidden" asp-for="UserId">
        <input type="hidden" asp-for="Code">
        <div class="field">
            <label asp-for="Input.Password"></label>
            <input asp-for="Input.Password" autocomplete="new-password">
            <p class="hint">At least 10 characters. A short sentence works well.</p>
        </div>
        <div class="field">
            <label asp-for="Input.ConfirmPassword"></label>
            <input asp-for="Input.ConfirmPassword" autocomplete="new-password">
        </div>
        <div class="actions">
            <button class="btn primary" type="submit">Save new password</button>
            <a asp-page="/Account/ForgotPassword">Send me a new link</a>
        </div>
    </form>
}
