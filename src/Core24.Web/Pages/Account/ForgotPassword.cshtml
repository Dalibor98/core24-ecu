@page "/account/forgot-password"
@model Core24.Web.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot password";
}
<div class="head">
    <p class="eyebrow">Account</p>
    <h1>Forgot your password?</h1>
    <p class="lede">Enter your email and we'll send you a link to choose a new one.</p>
</div>

@if (Model.Sent)
{
    <div class="notice ok">
        If <b>@Model.Input.Email</b> has an account, a reset link is on its way. Check your inbox (and the spam folder).
    </div>
}
else
{
    <form method="post" class="card stack">
        <div asp-validation-summary="All"></div>
        <div class="field">
            <label asp-for="Input.Email">Email</label>
            <input asp-for="Input.Email" autocomplete="email">
        </div>
        <div class="actions">
            <button class="btn primary" type="submit">Send the link</button>
            <a asp-page="/Account/Login">Back to log in</a>
        </div>
    </form>
}
