{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "Logs": {
    "Path": "App_Data/logs/core24-.log"
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=App_Data/core24.db"
  },
  "App": {
    "PublicBaseUrl": "",
    "Currency": "EUR"
  },
  "Uploads": {
    "MaxFiles": 6,
    "MaxFileBytes": 16777216,
    "AllowedExtensions": [ ".bin", ".ori" ],
    "RejectChecksumMismatch": false
  },
  "Storage": {
    "RootPath": "App_Data/files"
  },
  "Email": {
    "Mode": "Smtp",
    "FromAddress": "",
    "FromName": "CORE24",
    "WorkshopAddress": "",
    "SmtpHost": "",
    "SmtpPort": 587,
    "SmtpUsername": "",
    "SmtpPassword": ""
  },
  "Payments": {
    "Provider": "Stripe",
    "StripeSecretKey": "",
    "StripeWebhookSecret": ""
  },
  "Admin": {
    "Email": "",
    "Password": "",
    "RequireTwoFactor": false
  },
  "Alerts": {
    "To": "",
    "BatchDelay": "00:01:00",
    "Cooldown": "00:15:00"
  },
  "Maintenance": {
    "Enabled": true,
    "Interval": "01:00:00",
    "FileRetentionDays": 90,
    "FirstReminderDays": 3,
    "SecondReminderDays": 7
  },
  "ReverseProxy": {
    "Enabled": false
  }
}
